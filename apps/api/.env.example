NODE_ENV=development
PORT=5000
DATABASE_HOST=YOUR_SUPABASE_POOLER_HOST
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=YOUR_SUPABASE_POOLER_USER
DATABASE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
DATABASE_SSL=true
PGSSLROOTCERT=supabase-root-ca.crt
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
PASSWORD_PEPPER=GENERATE_A_PRIVATE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
BACKUP_ENCRYPTION_KEY=GENERATE_A_PRIVATE_32_BYTE_BASE64_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=loginauth-backups
AWS_S3_PREFIX=loginauth
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# Optional for temporary credentials; never configure AWS secrets in Vite/Vercel.
AWS_SESSION_TOKEN=
RECOVERY_DATABASE_HOST=
RECOVERY_DATABASE_PORT=5432
RECOVERY_DATABASE_NAME=
RECOVERY_DATABASE_USER=
RECOVERY_DATABASE_PASSWORD=
RECOVERY_DATABASE_SSL=true
